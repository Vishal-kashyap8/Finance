DB_SERVER=localhost
DB_DATABASE=FinanceTracker
# For Windows Authentication (recommended for local SQL Server):
DB_TRUSTED_CONNECTION=true
# For SQL Server Authentication (uncomment and fill):
# DB_USER=sa
# DB_PASSWORD=YourPassword123
PORT=3001

# ── Banking Profiles encryption ───────────────────────────────────────────────
# Used to encrypt/decrypt sensitive Banking Profile fields at rest in SQL Server
# (Account Number, Customer ID, Net Banking Username, Net Banking Password).
# Set this to a strong random passphrase. KEEP IT SECRET AND BACK IT UP —
# losing this value makes existing encrypted rows permanently unreadable.
DB_ENCRYPT_KEY=change-this-to-a-strong-random-passphrase
